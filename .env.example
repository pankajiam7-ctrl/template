# ── AI Provider ─────────────────────────────────────
# Change this to switch between providers: "anthropic" or "openai"
AI_PROVIDER=anthropic

# ── Anthropic ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenAI ───────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Server ───────────────────────────────────────────
PORT=3001

# ── MongoDB ──────────────────────────────────────────
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/proposalai

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=7d

# ── Email (Nodemailer) ───────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=ProposalAI <your@gmail.com>

# ── Frontend URL ─────────────────────────────────────
FRONTEND_URL=http://localhost:5173
